# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# journal chart snapshots (local only)
/public/journal-snapshots/

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright test results
/test-results/
/playwright-report/

# IDE / Assistant specific
.windsurf/
openmemory.md

# Research / docs (not source code)
*.pdf
QA_REPORT.md

# Jira scripts (local tooling)
/scripts/create-jira-tickets.py

# Proprietary fonts (not redistributable)
/public/fonts/sf-pro/
