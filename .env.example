# PhantomX — Environment Variables
# Copy this to .env.local and fill in your values

# Phemex API — Mainnet (can also be configured via the UI)
PHEMEX_API_KEY=your_phemex_api_key
PHEMEX_API_SECRET=your_phemex_api_secret

# Set to true to connect to testnet sandbox instead of mainnet
PHEMEX_TESTNET=true

# Phemex API — Testnet (optional, used when PHEMEX_TESTNET=true)
# If not set, falls back to PHEMEX_API_KEY/SECRET above
PHEMEX_TESTNET_API_KEY=your_phemex_testnet_api_key
PHEMEX_TESTNET_API_SECRET=your_phemex_testnet_api_secret

# Claude Agent SDK — OAuth token is read automatically from ~/.claude/.credentials.json
# No ANTHROPIC_API_KEY needed — uses Claude Max subscription via OAuth
# Override the claude-code executable path if needed:
# CLAUDE_CODE_PATH=/path/to/claude-code/cli.js

# Webhook secret (optional, for securing TradingView webhook endpoint)
WEBHOOK_SECRET=your_webhook_secret

# Server port
PORT=3000
